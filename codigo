const int trigPin = 9;
const int echoPin = 10;

const int ledRojo = 2;     // ACTIVO
const int ledAmarillo = 3; // REPOSO

const int buzzer = 8;

void setup() {

  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  pinMode(ledRojo, OUTPUT);
  pinMode(ledAmarillo, OUTPUT);

  pinMode(buzzer, OUTPUT);

  Serial.begin(9600);

  // INICIO EN REPOSO
  digitalWrite(ledRojo, LOW);
  digitalWrite(ledAmarillo, HIGH);

  noTone(buzzer);

  delay(2000); // estabilizar sensor
}

void loop() {

  long duracion;
  int distancia;

  // Limpiar trigger
  digitalWrite(trigPin, LOW);
  delayMicroseconds(5);

  // Pulso ultrasónico
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  // Leer eco
  duracion = pulseIn(echoPin, HIGH, 30000);

  // Si no recibe eco
  if (duracion == 0) {

    distancia = 999;
  }
  else {

    distancia = duracion * 0.034 / 2;
  }

  Serial.print("Distancia: ");
  Serial.println(distancia);

  // ---------- DETECCION REAL ----------

  if (distancia >= 2 && distancia <= 20) {

    // ACTIVO
    digitalWrite(ledRojo, HIGH);

    // REPOSO OFF
    digitalWrite(ledAmarillo, LOW);

    tone(buzzer, 1500);
  }

  // ---------- REPOSO ----------

  else {

    digitalWrite(ledRojo, LOW);

    digitalWrite(ledAmarillo, HIGH);

    noTone(buzzer);
  }

  delay(150);
}
